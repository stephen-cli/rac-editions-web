#!/bin/sh
# No game data in a commit: see scripts/check-game-data.ts. It needs Node 24.11 or newer, which runs
# TypeScript directly; an older node on PATH would fail with a syntax error, so say what is wrong instead.
major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
if [ "$major" -lt 24 ]; then
  echo "pre-commit: the game-data check needs Node 24.11 or newer on PATH (found $(node --version 2>/dev/null || echo none)); see README." >&2
  exit 1
fi
exec node scripts/check-game-data.ts --staged
